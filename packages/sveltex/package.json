{
  "name": "@nvl/sveltex",
  "version": "0.5.0",
  "description": "Svelte + Markdown + LaTeX",
  "type": "module",
  "author": {
    "name": "N. V. Lang",
    "email": "npm@nvlang.dev",
    "url": "https://nvlang.dev/"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "types": "./dist/mod.d.ts",
  "private": false,
  "keywords": [
    "sveltex",
    "svelte",
    "mdx",
    "markdown",
    "tex",
    "latex",
    "math",
    "preprocess",
    "preprocessor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nvlang/sveltex.git"
  },
  "bugs": {
    "url": "https://github.com/nvlang/sveltex/issues"
  },
  "homepage": "https://sveltex.dev",
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/src/main.js",
    "clean": "rimraf coverage dist tmp",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit --skipLibCheck",
    "test": "vitest run --coverage",
    "test:e2e": "pnpm test:e2e:prepare && playwright test",
    "test:e2e:golden": "pnpm test:e2e:prepare && playwright test --update-snapshots",
    "test:e2e:prepare": "pnpm build && pnpm exec playwright install && pnpm generate-projects && pnpm test:e2e:install && pnpm test:e2e:build && pnpm test:e2e:build:showcase",
    "generate-projects": "node --import tsx/esm tests/e2e/generate.ts",
    "test:e2e:install": "cd tests/e2e/_template && pnpm install && cd ../../..",
    "test:e2e:build": "node --import tsx/esm tests/e2e/build-projects.ts",
    "test:e2e:build:showcase": "node --import tsx/esm tests/e2e/build-showcase.ts",
    "playwright": "playwright test",
    "playwright:golden": "playwright test --update-snapshots",
    "format": "prettier --write .",
    "test:watch": "vitest --watch",
    "prepare": "cd ../.. && husky packages/sveltex/.husky",
    "knip": "knip",
    "ci": "pnpm install"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.1",
    "@mathjax/mathjax-fira-font": "^4.1.2",
    "@mathjax/mathjax-newcm-font": "^4.1.2",
    "@mathjax/src": "^4.1.2",
    "@playwright/test": "^1.60.0",
    "@shikijs/transformers": "^4.1.0",
    "@types/hast": "^3.0.4",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/mock-fs": "^4.13.4",
    "@types/node": "^24.12.4",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "@wooorm/starry-night": "^3.9.0",
    "hast-util-find-and-replace": "^5.0.1",
    "hastscript": "^9.0.1",
    "highlight.js": "^11.11.1",
    "husky": "^9.1.7",
    "katex": "^0.17.0",
    "knip": "^6.14.2",
    "markdown-it": "^14.2.0",
    "markdown-it-multimd-table": "^4.2.3",
    "marked": "^18.0.4",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "mock-fs": "^5.5.0",
    "msw": "^2.14.6",
    "prettier": "^3.8.3",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-retext": "^6.0.1",
    "retext-indefinite-article": "^5.0.0",
    "shiki": "^4.1.0",
    "sirv": "^3.0.2",
    "speech-rule-engine": "5.0.0-rc.1",
    "tslib": "^2.8.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@types/html-escaper": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "deepmerge-ts": "^7.1.5",
    "find-cache-directory": "^6.0.0",
    "glob": "^13.0.6",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "html-escaper": "^3.0.3",
    "html-tag-names": "^2.1.0",
    "js-yaml": "^4.1.1",
    "magic-string": "^0.30.21",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-math": "^3.0.0",
    "mdast-util-mdx-expression": "^2.0.1",
    "mdast-util-mdx-jsx": "^3.2.0",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-extension-mdx": "^2.1.0",
    "micromark-extension-mdx-expression": "^3.0.1",
    "micromark-extension-mdx-jsx": "^3.0.2",
    "micromark-extension-mdx-md": "^2.0.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-html-tag-name": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "node-poppler": "^9.1.2",
    "ora": "^9.4.0",
    "picocolors": "^1.1.1",
    "pretty-bytes": "^7.1.0",
    "radash": "^12.1.1",
    "regex": "^6.1.0",
    "rfdc": "^1.4.1",
    "rimraf": "^6.1.3",
    "sanitize-html": "^2.17.4",
    "smol-toml": "^1.6.1",
    "svelte": "^5.55.9",
    "svgo": "^4.0.1",
    "tsafe": "^1.8.12",
    "uuid": "^14.0.0",
    "xregexp": "^5.1.2"
  },
  "peerDependencies": {
    "@mathjax/src": "^4",
    "@wooorm/starry-night": "^3",
    "hast-util-find-and-replace": "^5",
    "highlight.js": "^11",
    "katex": "^0.16 || ^0.17",
    "markdown-it": "^14",
    "marked": "^18",
    "micromark": "^4",
    "rehype-stringify": "^10",
    "remark-parse": "^11",
    "remark-rehype": "^11",
    "remark-retext": "^6",
    "shiki": "^4",
    "unified": "^11"
  },
  "peerDependenciesMeta": {
    "@mathjax/src": {
      "optional": true
    },
    "@wooorm/starry-night": {
      "optional": true
    },
    "hast-util-find-and-replace": {
