{
  "name": "e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm prebuild && pnpm generate-tests && vite build",
    "prebuild": "esbuild sveltex.config.ts --outfile=sveltex.config.js",
    "generate-tests": "node generate-tests.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@mathjax/mathjax-fira-font": "^4.0.0",
    "@mathjax/src": "^4.0.0",
    "@nvl/sveltex": "file:../..",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.49.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@wooorm/starry-night": "^3.8.0",
    "esbuild": "0.27.1",
    "glob": "^13.0.0",
    "hast-util-find-and-replace": "^5.0.1",
    "hast-util-to-html": "^9.0.5",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.27",
    "markdown-it": "^14.1.0",
    "marked": "^17.0.1",
    "micromark": "^4.0.2",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.20.0",
    "svelte": "^5.46.0",
    "svelte-check": "^4.3.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.3.0"
  }
}
