{
  // The extension is compiled and bundled by esbuild (see `scripts/build.ts`);
  // this config exists purely to type-check `src/`. Hence `noEmit` — `dist/`
  // is produced entirely by esbuild.
  "compilerOptions": {
    "module": "CommonJS",
    // TS 6 deprecates the `Node`/`node10` resolution and explicitly
    // recommends `bundler` as the upgrade path for CJS projects that have
    // an external bundler. esbuild (see `scripts/build.ts`) is the bundler
    // here -- this tsconfig only type-checks.
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
