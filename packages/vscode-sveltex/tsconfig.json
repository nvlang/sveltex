{
  // The extension is compiled and bundled by esbuild (see `scripts/build.ts`);
  // this config exists purely to type-check `src/`. Hence `noEmit` — `dist/`
  // is produced entirely by esbuild.
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    // `moduleResolution: "Node"` (alias of `node10`) is deprecated in TS 6
    // and will be removed in TS 7. The VS Code extension API is a CJS
    // package, and `Node10`/`Node` resolution is what tsserver inside VS
    // Code itself uses to type-check extension source -- so keep matching
    // it for now and revisit when VS Code's API tooling moves on.
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
