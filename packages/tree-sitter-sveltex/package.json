{
  "name": "@nvl/tree-sitter-sveltex",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for SvelTeX (.sveltex) documents",
  "license": "MIT",
  "author": {
    "name": "N. V. Lang",
    "email": "npm@nvlang.dev",
    "url": "https://nvlang.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nvlang/sveltex.git",
    "directory": "packages/tree-sitter-sveltex"
  },
  "bugs": {
    "url": "https://github.com/nvlang/sveltex/issues"
  },
  "homepage": "https://sveltex.dev",
  "keywords": [
    "tree-sitter",
    "parser",
    "sveltex",
    "svelte",
    "markdown",
    "latex"
  ],
  "main": "bindings/node",
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "queries/*.scm",
    "src/**",
    "bindings/node/*"
  ],
  "tree-sitter": [
    {
      "scope": "source.sveltex",
      "file-types": [
        "sveltex"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "injections": [
        "queries/injections.scm"
      ],
      "folds": [
        "queries/folds.scm"
      ]
    }
  ],
  "scripts": {
    "install": "node-gyp-build",
    "generate": "tree-sitter generate",
    "test": "tree-sitter generate && tree-sitter test",
    "parse": "tree-sitter parse"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.8.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "tree-sitter": "0.25.0",
    "tree-sitter-cli": "^0.26.8"
  }
}
