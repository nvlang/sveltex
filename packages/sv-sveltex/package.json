{
  "name": "@nvl/sv-sveltex",
  "version": "0.1.0",
  "description": "Community sv add-on for SvelTeX (Svelte + Markdown + LaTeX)",
  "type": "module",
  "license": "MIT",
  "private": false,
  "author": {
    "name": "N. V. Lang",
    "email": "npm@nvlang.dev",
    "url": "https://nvlang.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nvlang/sveltex.git",
    "directory": "packages/sv-sveltex"
  },
  "bugs": {
    "url": "https://github.com/nvlang/sveltex/issues"
  },
  "homepage": "https://sveltex.dev",
  "keywords": [
    "sv-add",
    "sveltex",
